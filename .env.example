# NurseMatch backend - example environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# Server
SERVER_PORT=8080

# MongoDB (include credentials here only in your local .env, never in source)
MONGODB_URI=mongodb://localhost:27017/matchnp
MONGODB_DATABASE=matchnp

# JWT signing key: hex-encoded, at least 32 bytes (64 hex chars) for HS256.
# Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-character-secret
JWT_EXPIRATION_MS=86400000

# Geocoding (OpenStreetMap Nominatim). Include a contact address per the usage policy.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=NurseMatch-App/1.0 (your-contact@example.com)
